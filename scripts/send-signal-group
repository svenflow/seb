#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx"]
# ///
"""Send a Signal message to a group via signal-cli-rest-api.

Usage: send-signal-group <group_id> <message>

The group_id is the base64-encoded group ID from signal-cli.
Reads SIGNAL_NUMBER and SIGNAL_API_URL from environment or ~/seb/.env.
"""

import os
import sys
from pathlib import Path

import httpx


def main() -> None:
  if len(sys.argv) < 3:
    print("Usage: send-signal-group <group_id> <message>", file=sys.stderr)
    sys.exit(1)

  group_id = sys.argv[1]
  text = sys.argv[2]

  # Load .env if environment vars aren't set
  env_file = Path(__file__).parent.parent / ".env"
  if env_file.exists() and not os.getenv("SIGNAL_NUMBER"):
    for line in env_file.read_text().splitlines():
      line = line.strip()
      if line and not line.startswith("#") and "=" in line:
        key, _, value = line.partition("=")
        os.environ.setdefault(key.strip(), value.strip())

  signal_number = os.environ.get("SIGNAL_NUMBER")
  if not signal_number:
    print("Error: SIGNAL_NUMBER not set", file=sys.stderr)
    sys.exit(1)

  api_url = os.environ.get("SIGNAL_API_URL", "http://127.0.0.1:6001").rstrip("/")

  # signal-cli-rest-api v2/send expects group IDs in "group.<base64>" format
  # under the "recipients" field
  import base64
  # The group_id comes in as the internal_id (raw base64). Convert to the
  # "group.<base64-of-base64>" format the API expects.
  encoded_group = "group." + base64.b64encode(group_id.encode()).decode()
  payload = {
    "number": signal_number,
    "recipients": [encoded_group],
    "message": text,
  }

  resp = httpx.post(f"{api_url}/v2/send", json=payload, timeout=30)
  resp.raise_for_status()
  print(f"Sent to group {group_id}")


if __name__ == "__main__":
  main()
