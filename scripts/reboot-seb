#!/usr/bin/env bash
# Reboot seb by restarting the systemd user service.
# Sends a confirmation message before restarting.
#
# Usage: reboot-seb
#
# This script is designed to be called by seb (Claude) from a chat session.
# It triggers a graceful restart via systemctl, which saves session state
# and lets systemd bring seb back up.

set -euo pipefail

echo "Triggering seb restart via systemctl..."
# Use --user since seb runs as a user service
# Run in background so the script can exit before the service dies
nohup bash -c 'sleep 1 && systemctl --user restart seb.service' >/dev/null 2>&1 &
echo "Restart scheduled. seb will be back in ~10 seconds."
