# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — get from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAG...

# Signal — the phone number signal-cli is registered with (E.164 format)
SIGNAL_NUMBER=+12025551234
# Base URL for signal-cli-rest-api Docker container
SIGNAL_API_URL=http://127.0.0.1:6001

# Your personal identifiers — used for admin tier
# Telegram: your numeric user ID (message @userinfobot to get it)
ADMIN_TELEGRAM_ID=123456789
# Signal: your personal number (E.164 format)
ADMIN_SIGNAL_NUMBER=+12025551234

# Additional trusted contacts (comma-separated)
# Telegram user IDs
TRUSTED_TELEGRAM_IDS=
# Signal numbers (E.164, comma-separated)
TRUSTED_SIGNAL_NUMBERS=

# Memory service
MEMORY_SERVICE_URL=http://localhost:7890

# Claude model
# Model options: claude-haiku-4-5-20251001 (default), claude-sonnet-4-6, claude-opus-4-6
# Override per-message via Signal: --haiku, --sonnet, --opus (sticky for session)
CLAUDE_MODEL=claude-haiku-4-5-20251001
